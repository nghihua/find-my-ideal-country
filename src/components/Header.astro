---
// Top-Left Header & Search Bar
import { tFor, DEFAULT_LOCALE, UI_LOCALES, LOCALE_DISPLAY_NAMES } from '../i18n';
const t = tFor(Astro.currentLocale);
// Language switcher (docs/i18n-plan.md §7): a no-JS <details> dropdown driven
// by UI_LOCALES, so adding a locale needs no component change. Each entry
// links to the same prerendered shell in that locale; in-memory state (open
// quiz, selected country) resets by design.
const current: string = Astro.currentLocale;
const knownLocales = UI_LOCALES as readonly string[];
const shownLocales: string[] = knownLocales.includes(current)
  ? [...knownLocales]
  : [current, ...knownLocales];
const nameOf = (l: string) => LOCALE_DISPLAY_NAMES[l as keyof typeof LOCALE_DISPLAY_NAMES] ?? l;
---
<header class="fixed top-4 left-4 right-4 md:right-auto z-30 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 pointer-events-none">
    <!-- Main Branding Pill / Card -->
    <div class="bg-white border border-[#dadce0] rounded-full sm:rounded-2xl px-4 py-2.5 pointer-events-auto flex items-center justify-between gap-3 shadow-[0_2px_6px_rgba(60,64,67,0.15),0_1px_2px_rgba(60,64,67,0.3)] hover:shadow-[0_4px_8px_3px_rgba(60,64,67,0.15)] transition-shadow">
        <div class="flex items-center gap-3">
            <!-- Globe Icon -->
            <div class="w-9 h-9 rounded-full bg-[#e8f0fe] flex items-center justify-center shrink-0 text-[#1a73e8]">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
            </div>
            <div>
                <h1 class="font-display font-medium text-sm sm:text-base tracking-tight text-[#202124] leading-tight">
                    {t('header.brand.title')}
                </h1>
                <p class="text-[11px] text-[#5f6368] hidden sm:block font-normal">{t('header.brand.subtitle')}</p>
            </div>
        </div>

        <!-- Language switcher: prerendered dropdown over all UI_LOCALES -->
        <details id="lang-switch" class="relative group">
            <summary aria-label={t('header.langSwitch')} title={t('header.langSwitch')} class="list-none inline-flex h-8 items-center gap-1 px-2.5 rounded-full bg-transparent hover:bg-[#f1f3f4] active:bg-[#e8eaed] text-[#5f6368] hover:text-[#1a73e8] text-xs font-medium whitespace-nowrap cursor-pointer select-none transition-colors [&::-webkit-details-marker]:hidden">
                {nameOf(current)}
                <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-44 bg-white border border-[#dadce0] rounded-2xl p-1.5 space-y-0.5 z-50 shadow-[0_8px_24px_rgba(60,64,67,0.2)] pointer-events-auto">
                {shownLocales.map((l) => (
                    <a
                        href={`/${l}/`}
                        lang={l}
                        aria-current={l === current ? 'true' : undefined}
                        class:list={["flex items-center justify-between gap-2 px-3 py-2 rounded-xl text-sm transition-colors", l === current ? "bg-[#e8f0fe] text-[#1a73e8] font-medium" : "text-[#202124] hover:bg-[#f1f3f4]"]}
                    >
                        <span>{nameOf(l)}</span>
                        {l === current && (
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                            </svg>
                        )}
                    </a>
                ))}
            </div>
        </details>

        <!-- Reset the map to its full-world view -->
        <button id="reset-zoom-btn" type="button" aria-label={t('header.resetZoom')} title={t('header.resetZoom')} class="w-8 h-8 rounded-full bg-transparent hover:bg-[#f1f3f4] active:bg-[#e8eaed] text-[#5f6368] hover:text-[#202124] flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
        </button>
    </div>

    <!-- Quick Country Search Bar -->
    <div class="relative pointer-events-auto">
        <div class="bg-white border border-[#dadce0] rounded-full px-4 py-2 flex items-center gap-2.5 shadow-[0_2px_6px_rgba(60,64,67,0.15),0_1px_2px_rgba(60,64,67,0.3)] hover:shadow-[0_4px_8px_3px_rgba(60,64,67,0.15)] focus-within:shadow-[0_4px_8px_3px_rgba(60,64,67,0.15)] focus-within:border-[#1a73e8] transition-all">
            <svg class="w-4 h-4 text-[#5f6368] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input id="country-search" type="text" autocomplete="off" aria-label={t('header.searchLabel')} placeholder={t('header.searchPlaceholder')} class="bg-transparent border-none outline-none text-sm text-[#202124] placeholder-[#80868b] w-full sm:w-56 font-sans">
        </div>

        <!-- Autocomplete Results Dropdown -->
        <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-2 bg-white border border-[#dadce0] rounded-2xl overflow-hidden max-h-72 overflow-y-auto z-50 shadow-[0_8px_24px_rgba(60,64,67,0.2)] p-1.5 space-y-0.5"></div>
    </div>
</header>
