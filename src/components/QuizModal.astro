---
// Quiz Button (Google Extended FAB) & Modal Dialog
---
<!-- Floating Corner Google Extended FAB: "Find My Ideal Country" -->
<button id="open-quiz-btn" class="fixed bottom-20 sm:bottom-6 right-4 sm:right-6 z-30 group flex items-center gap-3 bg-[#1a73e8] hover:bg-[#1557b0] active:bg-[#174ea6] text-white font-medium px-5 py-3.5 rounded-full shadow-[0_4px_8px_3px_rgba(60,64,67,0.15),0_1px_3px_0_rgba(60,64,67,0.3)] hover:shadow-[0_6px_12px_4px_rgba(60,64,67,0.15),0_2px_4px_0_rgba(60,64,67,0.3)] transition-all duration-200">
    <!-- Google Sparkle Icon -->
    <span class="w-5 h-5 flex items-center justify-center">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L14.39 8.26L21 9.27L16.27 13.73L17.41 20.3L12 17.27L6.59 20.3L7.73 13.73L3 9.27L9.61 8.26L12 2Z"/>
        </svg>
    </span>
    <span class="font-display text-sm tracking-normal font-medium">Find My Ideal Country</span>
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
</button>

<!-- Quiz Modal Overlay (Google Material 3 Dialog) -->
<div id="quiz-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-[#202124]/40 backdrop-blur-xs">
    <!-- max-h-[90vh] is the fallback; 90svh wins on modern mobile so the dialog always
         fits above the browser toolbar and never resizes while scrolling internally. -->
    <div class="bg-white border border-[#dadce0] w-full max-w-2xl rounded-3xl shadow-[0_12px_28px_rgba(60,64,67,0.28)] overflow-hidden flex flex-col max-h-[90vh] max-h-[90svh] select-text">
        <!-- Google 4-Color Accent Strip -->
        <div class="google-accent-bar shrink-0"></div>

        <!-- Quiz Header -->
        <div class="p-5 sm:p-6 bg-white border-b border-[#dadce0] flex items-center justify-between z-10 shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-[#e8f0fe] flex items-center justify-center text-[#1a73e8] shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-display font-medium text-base sm:text-lg text-[#202124]">Lifestyle & Relocation Matcher</h3>
                    <p id="quiz-subtitle" class="text-xs text-[#5f6368] font-normal">Find your ideal home across 170+ destinations</p>
                </div>
            </div>
            <button id="close-quiz-btn" title="Close" class="w-9 h-9 rounded-full bg-transparent hover:bg-[#f1f3f4] active:bg-[#e8eaed] text-[#5f6368] hover:text-[#202124] flex items-center justify-center transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Google Linear Progress Indicator Bar -->
        <div class="w-full h-1 bg-[#e8f0fe]">
            <div id="quiz-progress" class="h-full bg-[#1a73e8] transition-all duration-300" style="width: 20%"></div>
        </div>

        <!-- Quiz Body -->
        <div id="quiz-body" class="p-5 sm:p-6 sm:px-8 overflow-y-auto flex-1 bg-white">
            <!-- Question or Result dynamically rendered here -->
        </div>
    </div>
</div>
