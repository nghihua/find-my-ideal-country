---
// Map Container, Loader, Tooltip (Google Maps & Earth Cartography)
import { tFor } from '../i18n';
const t = tFor(Astro.currentLocale);
---
<!-- Main Interactive Map Container -->
<div id="map-container" class="relative w-full h-full z-10 flex items-center justify-center">
    <!-- Loading State (Google Style Spinner) -->
    <div id="map-loader" class="flex flex-col items-center gap-3 text-[#5f6368]">
        <div class="w-10 h-10 border-4 border-[#dadce0] border-t-[#1a73e8] rounded-full animate-spin"></div>
        <p class="text-xs sm:text-sm font-medium tracking-normal text-[#202124]">{t('map.loading')}</p>
    </div>
    <svg id="world-map" class="w-full h-full hidden"></svg>
</div>

<div id="map-legend" class="hidden fixed left-4 bottom-5 z-30 rounded-xl border border-[#dadce0] bg-white/95 px-3 py-2 text-[11px] text-[#202124] shadow-lg" aria-label={t('map.legendAriaLabel')}>
    <div class="font-semibold mb-1">{t('map.legendTitle')}</div>
    <div class="flex items-center gap-2"><i class="w-3 h-3 rounded-sm bg-[#d9f2e3]"></i>{t('map.legendTop5')}</div>
    <div class="flex items-center gap-2"><i class="w-3 h-3 rounded-sm bg-[#fff0c2]"></i>{t('map.legend80')}</div>
    <div class="flex items-center gap-2"><i class="w-3 h-3 rounded-sm bg-[#f1f3f4]"></i>{t('map.legendNeutral')}</div>
</div>

<!-- Hover Tooltip (Google Maps Location Pill) -->
<div id="map-tooltip" class="fixed pointer-events-none z-40 hidden bg-white border border-[#dadce0] px-3 py-1.5 rounded-full text-xs font-medium text-[#202124] shadow-[0_2px_8px_rgba(60,64,67,0.2)] transform -translate-x-1/2 -translate-y-full mt-[-10px] flex items-center gap-1.5">
    {t('map.tooltipFallback')}
</div>
