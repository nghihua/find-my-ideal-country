---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "How Is Living There? — Interactive Global Lifestyle & Relocation Atlas" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <!-- D3.js & TopoJSON for Interactive World Map -->
    <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
    <script is:inline src="https://unpkg.com/topojson-client@3"></script>
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Newsreader (Editorial Serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Newsreader', 'serif'],
                    },
                    colors: {
                        paper: {
                            50: 'var(--color-paper-50)',
                            100: 'var(--color-paper-100)',
                            200: 'var(--color-paper-200)',
                            300: 'var(--color-paper-300)',
                            800: 'var(--color-paper-800)',
                            900: 'var(--color-paper-900)',
                        },
                        primary: {
                            DEFAULT: 'var(--color-primary)',
                            hover: 'var(--color-primary-hover)',
                        },
                        sage: {
                            DEFAULT: 'var(--color-map-featured)',
                            spinner: 'var(--color-map-spinner)',
                        },
                        teal: {
                            DEFAULT: 'var(--color-teal)',
                            dark: 'var(--color-teal-dark)',
                            light: 'var(--color-teal-light)',
                            bg: 'var(--color-teal-bg)',
                        },
                        coral: {
                            DEFAULT: 'var(--color-coral)',
                            light: 'var(--color-coral-light)',
                            dark: 'var(--color-coral-dark)',
                            muted: 'var(--color-coral-muted)',
                            bg: 'var(--color-coral-bg)',
                        },
                        amber: {
                            accent: 'var(--color-amber-accent)',
                            dark: 'var(--color-amber-dark)',
                            bg: 'var(--color-amber-bg)',
                            light: 'var(--color-amber-light)',
                            soft: 'var(--color-amber-soft)',
                            card: 'var(--color-amber-card)',
                        },
                        purple: {
                            accent: 'var(--color-purple-accent)',
                            dark: 'var(--color-purple-dark)',
                            light: 'var(--color-purple-light)',
                            bg: 'var(--color-purple-bg)',
                            card: 'var(--color-purple-card)',
                        },
                        green: {
                            accent: 'var(--color-green-accent)',
                            bg: 'var(--color-green-bg)',
                        },
                        badge: 'var(--color-badge-bg)',
                        hoverCard: 'var(--color-hover-card)',
                        hoverQuiz: 'var(--color-hover-quiz)',
                        quizIcon: 'var(--color-quiz-icon-bg)',
                    },
                    boxShadow: {
                        'paper-sm': '0 2px 6px -1px rgba(var(--shadow-paper-rgb), 0.05), 0 1px 3px -1px rgba(var(--shadow-paper-rgb), 0.03)',
                        'paper': '0 8px 20px -4px rgba(var(--shadow-paper-rgb), 0.08), 0 3px 8px -2px rgba(var(--shadow-paper-rgb), 0.04)',
                        'paper-lg': '0 20px 35px -8px rgba(var(--shadow-paper-rgb), 0.12), 0 8px 16px -6px rgba(var(--shadow-paper-rgb), 0.06)',
                        'paper-drawer': '-12px 0 36px -6px rgba(var(--shadow-paper-rgb), 0.11)',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-paper-100 text-paper-900 overflow-hidden select-none h-screen w-screen relative font-sans">
    <slot />

    <script src="../scripts/app.ts"></script>
</body>
</html>
