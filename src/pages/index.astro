---
import { COUNTRY_DATABASE, REGIONAL_TEMPLATES, QUIZ_QUESTIONS } from '../data/countries';

const countryDatabaseJson = JSON.stringify(COUNTRY_DATABASE);
const regionalTemplatesJson = JSON.stringify(REGIONAL_TEMPLATES);
const quizQuestionsJson = JSON.stringify(QUIZ_QUESTIONS);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>How Is Living There? — Interactive Global Lifestyle & Relocation Atlas</title>
    <!-- Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <!-- D3.js & TopoJSON for Interactive World Map -->
    <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
    <script is:inline src="https://unpkg.com/topojson-client@3"></script>
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Newsreader (Editorial Serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Newsreader', 'serif'],
                    },
                    colors: {
                        paper: {
                            50: '#fffdf9',
                            100: '#faf6ef',
                            200: '#f3ece0',
                            300: '#e8decb',
                            800: '#3f3b37',
                            900: '#2d2a27',
                        }
                    },
                    boxShadow: {
                        'paper-sm': '0 2px 6px -1px rgba(63, 59, 55, 0.05), 0 1px 3px -1px rgba(63, 59, 55, 0.03)',
                        'paper': '0 8px 20px -4px rgba(63, 59, 55, 0.08), 0 3px 8px -2px rgba(63, 59, 55, 0.04)',
                        'paper-lg': '0 20px 35px -8px rgba(63, 59, 55, 0.12), 0 8px 16px -6px rgba(63, 59, 55, 0.06)',
                        'paper-drawer': '-12px 0 36px -6px rgba(63, 59, 55, 0.11)',
                    }
                }
            }
        }
    </script>
    <style>
        /* Subtle organic paper grain overlay */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 60;
            opacity: 0.32;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.14'/%3E%3C/svg%3E");
        }

        /* Custom Scrollbar for Paper Dossier */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #faf6ef;
        }
        ::-webkit-scrollbar-thumb {
            background: #dfd5c5;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #cbbda8;
        }

        /* Map Country Styling — Soft Pastel Atlas Cartography */
        .country {
            transition: fill 0.25s ease, stroke 0.25s ease;
            cursor: pointer;
        }
        .country:hover {
            fill: #f6c28b !important; /* Pastel Apricot Hover */
        }
        .country.featured {
            fill: #98b9b4; /* Muted Pastel Sage-Teal */
        }
        .country.featured:hover {
            fill: #f6c28b !important;
        }
        .country.active {
            fill: #e8998d !important; /* Pastel Dusty Coral Stamp */
            stroke: #fffdf9 !important;
            stroke-width: 1.4px !important;
        }
        
        /* Tactile Paper Card Surface (Borderless, Shadow-Driven) */
        .paper-card {
            background-color: #fffdf9;
            box-shadow: 0 8px 20px -4px rgba(63, 59, 55, 0.08), 0 3px 8px -2px rgba(63, 59, 55, 0.04);
        }
        .paper-sheet {
            background-color: #faf6ef;
            box-shadow: 0 4px 12px -2px rgba(63, 59, 55, 0.06), 0 2px 4px -1px rgba(63, 59, 55, 0.03);
        }
    </style>
</head>
<body class="bg-paper-100 text-paper-900 overflow-hidden select-none h-screen w-screen relative font-sans">

    <!-- Subtle Pastel Vignette on Atlas Canvas -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_50%,rgba(232,222,203,0.45)_100%)]"></div>
    </div>

    <!-- Main Interactive Map Container -->
    <div id="map-container" class="relative w-full h-full z-10 flex items-center justify-center">
        <!-- Loading State -->
        <div id="map-loader" class="flex flex-col items-center gap-3 text-stone-500">
            <div class="w-10 h-10 border-4 border-stone-200 border-t-[#8ab0ab] rounded-full animate-spin"></div>
            <p class="text-sm font-medium tracking-wide">Unfolding Pastel World Atlas...</p>
        </div>
        <svg id="world-map" class="w-full h-full hidden"></svg>
    </div>

    <!-- Top-Left Header & Search Bar -->
    <header class="fixed top-4 left-4 right-4 md:right-auto z-30 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pointer-events-none">
        <div class="paper-card rounded-2xl px-4 py-3 pointer-events-auto flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#98b9b4] flex items-center justify-center shadow-paper-sm">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-display font-bold text-base sm:text-lg tracking-tight text-paper-900 leading-tight">r/HowIsLivingThere</h1>
                    <p class="text-xs text-stone-500 hidden sm:block">Select a nation to open its field notes</p>
                </div>
            </div>

            <!-- Reset Zoom Button -->
            <button id="reset-zoom-btn" title="Reset World View" class="p-2 rounded-xl bg-paper-100 hover:bg-paper-200 text-stone-500 hover:text-paper-900 transition-all shadow-paper-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                </svg>
            </button>
        </div>

        <!-- Quick Country Search / Jump -->
        <div class="relative pointer-events-auto">
            <div class="paper-card rounded-2xl px-3.5 py-2.5 flex items-center gap-2">
                <svg class="w-4 h-4 text-stone-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input id="country-search" type="text" placeholder="Search a country (e.g., Japan, Vietnam)..." class="bg-transparent border-none outline-none text-sm text-paper-900 placeholder-stone-400 w-full sm:w-56">
            </div>
            <!-- Search Dropdown -->
            <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-2 paper-card rounded-2xl overflow-hidden max-h-64 overflow-y-auto z-50 space-y-0.5 p-1.5"></div>
        </div>
    </header>

    <!-- Map Legend (Bottom Left) -->
    <div class="fixed bottom-4 left-4 z-20 paper-card rounded-2xl px-4 py-2.5 text-xs text-stone-600 hidden sm:flex items-center gap-4">
        <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-sm bg-[#98b9b4] inline-block shadow-sm"></span>
            <span class="font-medium">Curated Field Guide</span>
        </div>
        <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-sm bg-[#e7dfd1] inline-block shadow-sm"></span>
            <span>Regional Overview</span>
        </div>
    </div>

    <!-- Floating Corner CTA: "Where Should I Live?" Quiz Button -->
    <button id="open-quiz-btn" class="fixed bottom-5 right-5 z-30 group flex items-center gap-3 bg-[#e8998d] hover:bg-[#df8577] text-white font-semibold px-5 py-3.5 rounded-2xl shadow-paper-lg transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0">
        <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-50"></span>
        </span>
        <span class="font-display text-sm sm:text-base tracking-tight">Find My Ideal Country</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
    </button>

    <!-- Hover Tooltip -->
    <div id="map-tooltip" class="fixed pointer-events-none z-40 hidden paper-card px-3 py-1.5 rounded-xl text-xs font-semibold text-paper-900 transform -translate-x-1/2 -translate-y-full mt-[-10px]">
        Country Name
    </div>

    <!-- Side Dossier Panel (Slide-over Paper Sheet) -->
    <aside id="country-panel" class="fixed top-0 right-0 h-full w-full md:w-[540px] lg:w-[600px] z-40 bg-paper-100 shadow-paper-drawer transform translate-x-full transition-transform duration-500 ease-out flex flex-col select-text">
        <!-- Panel Sticky Header -->
        <div class="p-5 sm:p-6 bg-paper-50 shadow-paper-sm flex items-start justify-between gap-4 shrink-0 z-10">
            <div>
                <div class="flex items-center gap-2.5 mb-1.5">
                    <span id="panel-icon" class="w-8 h-8 rounded-xl bg-[#98b9b4]/25 text-[#457268] flex items-center justify-center text-sm shadow-paper-sm">
                        <i class="fa-solid fa-earth-americas"></i>
                    </span>
                    <span id="panel-region" class="text-xs font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#efe8dc] text-stone-600">Region</span>
                    <span id="panel-badge" class="hidden text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#dff0ea] text-[#457268]"><i class="fa-solid fa-circle-check mr-1"></i>Verified Local Guide</span>
                </div>
                <h2 id="panel-title" class="font-display text-2xl sm:text-3xl font-extrabold text-paper-900 tracking-tight">Country Name</h2>
                <p id="panel-tagline" class="font-serif italic text-base text-stone-500 mt-1">"A brief summary of the vibe."</p>
            </div>
            <button id="close-panel-btn" class="p-2.5 rounded-xl bg-paper-100 hover:bg-paper-200 text-stone-500 hover:text-paper-900 transition-colors shrink-0 shadow-paper-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Quick Metrics Bar (3 Elevated Pastel Index Cards) -->
        <div id="panel-metrics" class="grid grid-cols-3 gap-3 px-5 sm:px-6 pt-5 shrink-0 text-center">
            <div class="bg-[#fdf6ec] shadow-paper rounded-2xl p-3">
                <div class="text-[10px] uppercase tracking-wider font-semibold text-stone-400">Monthly Cost</div>
                <div id="metric-cost" class="text-xs sm:text-sm font-bold text-paper-900 mt-1">$1,800</div>
            </div>
            <div class="bg-[#eef6f4] shadow-paper rounded-2xl p-3">
                <div class="text-[10px] uppercase tracking-wider font-semibold text-stone-400">Work-Life</div>
                <div id="metric-wlb" class="text-xs sm:text-sm font-bold text-[#52827b] mt-1">8.5 / 10</div>
            </div>
            <div class="bg-[#f3f1fa] shadow-paper rounded-2xl p-3">
                <div class="text-[10px] uppercase tracking-wider font-semibold text-stone-400">Safety</div>
                <div id="metric-safety" class="text-xs sm:text-sm font-bold text-[#6c6394] mt-1">Very High</div>
            </div>
        </div>

        <!-- Scrollable Dossier Content -->
        <div id="panel-content" class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-5">
            <!-- Dynamic Sections Injected via JS -->
        </div>
    </aside>

    <!-- Quiz Modal Overlay -->
    <div id="quiz-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-stone-800/30 backdrop-blur-sm">
        <div class="bg-paper-100 w-full max-w-2xl rounded-3xl shadow-paper-lg overflow-hidden flex flex-col max-h-[90vh] select-text">
            <!-- Quiz Header -->
            <div class="p-6 bg-paper-50 shadow-paper-sm flex items-center justify-between z-10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-[#98b9b4] flex items-center justify-center text-white shadow-paper-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-display font-bold text-lg text-paper-900">Lifestyle & Relocation Matcher</h3>
                        <p id="quiz-subtitle" class="text-xs text-stone-500">Answer 5 quick questions to find where you belong</p>
                    </div>
                </div>
                <button id="close-quiz-btn" class="p-2 rounded-xl bg-paper-100 hover:bg-paper-200 text-stone-500 hover:text-paper-900 transition-colors shadow-paper-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Progress Bar -->
            <div class="w-full h-1.5 bg-paper-200">
                <div id="quiz-progress" class="h-full bg-[#e8998d] transition-all duration-300" style="width: 20%"></div>
            </div>

            <!-- Quiz Body -->
            <div id="quiz-body" class="p-6 sm:p-8 overflow-y-auto flex-1">
                <!-- Question or Result dynamically rendered here -->
            </div>
        </div>
    </div>

    <!-- Custom Toast / Message Box (No alert() used) -->
    <div id="toast-box" class="fixed top-20 left-1/2 transform -translate-x-1/2 z-50 hidden paper-card px-4 py-2.5 rounded-2xl text-sm font-medium text-paper-900 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#e8998d]"></span>
        <span id="toast-message">Notification</span>
    </div>

    <script define:vars={{ countryDatabaseJson, regionalTemplatesJson, quizQuestionsJson }}>
        const COUNTRY_DATABASE = JSON.parse(countryDatabaseJson);
        const REGIONAL_TEMPLATES = JSON.parse(regionalTemplatesJson);
        const QUIZ_QUESTIONS = JSON.parse(quizQuestionsJson);

        // Global App State
        let worldFeatures = [];
        let svg, g, projection, path, zoom;
        let activeCountryName = null;
        let currentQuizStep = 0;
        let selectedQuizTags = [];

        // Helper: Show non-intrusive toast message
        function showToast(msg) {
            const box = document.getElementById('toast-box');
            const text = document.getElementById('toast-message');
            text.textContent = msg;
            box.classList.remove('hidden');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                box.classList.add('hidden');
            }, 3200);
        }

        // Helper: Get Fallback Region from map centroid
        function getFallbackRegion(centroid) {
            const [lon, lat] = centroid;
            if (lon > -25 && lon < 45 && lat > 35) return "Europe";
            if (lon >= 45 && lon < 150 && lat > -10) return "Asia";
            if (lon >= 110 && lat <= -10) return "Oceania";
            if (lon > -20 && lon < 55 && lat <= 35) return "Africa";
            return "Americas";
        }

        // Build complete dossier object (either curated or intelligently synthesized)
        function getCountryProfile(feature) {
            const rawName = feature.properties.name || "Unknown Territory";
            const nameMap = {
                "United States of America": "United States",
                "Korea": "South Korea",
                "Republic of Korea": "South Korea",
                "Viet Nam": "Vietnam"
            };
            const name = nameMap[rawName] || rawName;

            if (COUNTRY_DATABASE[name]) {
                return { ...COUNTRY_DATABASE[name], isCurated: true };
            }

            const centroid = d3.geoCentroid(feature);
            const region = getFallbackRegion(centroid);
            const tpl = REGIONAL_TEMPLATES[region];

            return {
                name: name,
                icon: "fa-solid fa-location-dot",
                region: region,
                tagline: `Everyday rhythms, local traditions, and real-world living insights in ${name}.`,
                cost: tpl.cost,
                wlb: tpl.wlb,
                safety: tpl.safety,
                culture: `Living in ${name} offers an authentic immersion into ${region}'s cultural fabric—shaped by local language, regional cuisine, and historic traditions. ${tpl.culture}`,
                people: `Residents of ${name} take strong pride in their heritage and local hospitality. ${tpl.people}`,
                costOfLiving: `In ${name}, day-to-day affordability depends heavily on whether you live in the capital city or secondary towns. ${tpl.costOfLiving}`,
                workday: `A typical weekday in ${name} blends local business customs with modern urban routines. ${tpl.workday}`,
                evening: `When the workday winds down in ${name}, locals head out to neighborhood gathering spots. ${tpl.evening}`,
                upsides: tpl.upsides,
                downsides: tpl.downsides,
                videos: [
                    {
                        title: `What Living in ${name} is Actually Like (Local & Expat Stories)`,
                        channel: "YouTube Global Guides",
                        duration: "Curated Search",
                        url: `https://www.youtube.com/results?search_query=what+living+in+${encodeURIComponent(name)}+is+actually+like`
                    },
                    {
                        title: `A Day in the Life in ${name} — Cost of Living & Culture`,
                        channel: "YouTube Street & Daily Life",
                        duration: "Curated Search",
                        url: `https://www.youtube.com/results?search_query=day+in+the+life+living+in+${encodeURIComponent(name)}`
                    }
                ],
                isCurated: false
            };
        }

        // Initialize D3 World Map
        async function initWorldMap() {
            const container = document.getElementById('map-container');
            const width = container.clientWidth;
            const height = container.clientHeight;

            svg = d3.select("#world-map")
                .attr("viewBox", [0, 0, width, height]);

            g = svg.append("g");

            projection = d3.geoNaturalEarth1()
                .scale(width / 5.4)
                .translate([width / 2, height / 1.85]);

            path = d3.geoPath().projection(projection);

            zoom = d3.zoom()
                .scaleExtent([1, 10])
                .on("zoom", (event) => {
                    g.attr("transform", event.transform);
                    g.selectAll(".country").style("stroke-width", `${0.75 / event.transform.k}px`);
                });

            svg.call(zoom);

            try {
                const response = await fetch("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json");
                const worldData = await response.json();
                worldFeatures = topojson.feature(worldData, worldData.objects.countries).features;
                worldFeatures = worldFeatures.filter(f => f.properties.name !== "Antarctica");

                document.getElementById('map-loader').classList.add('hidden');
                document.getElementById('world-map').classList.remove('hidden');

                const tooltip = document.getElementById('map-tooltip');

                g.selectAll("path")
                    .data(worldFeatures)
                    .join("path")
                    .attr("d", path)
                    .attr("class", d => {
                        const name = d.properties.name === "Viet Nam" ? "Vietnam" : (d.properties.name === "Korea" ? "South Korea" : d.properties.name);
                        return COUNTRY_DATABASE[name] ? "country featured" : "country";
                    })
                    .attr("fill", d => {
                        const name = d.properties.name === "Viet Nam" ? "Vietnam" : (d.properties.name === "Korea" ? "South Korea" : d.properties.name);
                        return COUNTRY_DATABASE[name] ? "#98b9b4" : "#e7dfd1";
                    })
                    .attr("stroke", "#fffdf9")
                    .attr("stroke-width", "0.75px")
                    .on("mousemove", (event, d) => {
                        const displayName = d.properties.name === "Viet Nam" ? "Vietnam" : d.properties.name;
                        const isCurated = !!COUNTRY_DATABASE[displayName];
                        tooltip.innerHTML = `${displayName} ${isCurated ? '<span class="text-[#d47a6c] ml-1.5"><i class="fa-solid fa-star text-[10px] mr-0.5"></i>Guide</span>' : ''}`;
                        tooltip.style.left = `${event.clientX}px`;
                        tooltip.style.top = `${event.clientY}px`;
                        tooltip.classList.remove("hidden");
                    })
                    .on("mouseleave", () => {
                        tooltip.classList.add("hidden");
                    })
                    .on("click", (event, d) => {
                        event.stopPropagation();
                        selectCountry(d);
                    });

                svg.on("click", () => {
                    resetZoom();
                });

            } catch (err) {
                console.error("Map load error:", err);
                document.getElementById('map-loader').innerHTML = `
                    <p class="text-rose-600 font-medium">Unable to load map geometry. Please check your connection.</p>
                `;
            }
        }

        function selectCountry(feature) {
            const width = document.getElementById('map-container').clientWidth;
            const height = document.getElementById('map-container').clientHeight;
            const isMobile = width < 768;

            g.selectAll(".country").classed("active", d => d === feature);

            const [[x0, y0], [x1, y1]] = path.bounds(feature);
            const dx = x1 - x0;
            const dy = y1 - y0;
            const x = (x0 + x1) / 2;
            const y = (y0 + y1) / 2;

            const availableWidth = isMobile ? width : width - 560;
            const targetCenterX = isMobile ? width / 2 : availableWidth / 2;
            const targetCenterY = height / 2;

            const scale = Math.max(1.5, Math.min(6.5, 0.65 / Math.max(dx / availableWidth, dy / height)));
            const translate = [targetCenterX - scale * x, targetCenterY - scale * y];

            svg.transition()
                .duration(850)
                .ease(d3.easeCubicInOut)
                .call(zoom.transform, d3.zoomIdentity.translate(translate[0], translate[1]).scale(scale));

            const profile = getCountryProfile(feature);
            renderCountryDossier(profile);
        }

        function resetZoom() {
            g.selectAll(".country").classed("active", false);
            closeCountryPanel();

            svg.transition()
                .duration(750)
                .ease(d3.easeCubicInOut)
                .call(zoom.transform, d3.zoomIdentity);
        }

        function renderCountryDossier(data) {
            document.getElementById('panel-icon').innerHTML = `<i class="${data.icon}"></i>`;
            document.getElementById('panel-region').textContent = data.region;
            document.getElementById('panel-title').textContent = data.name;
            document.getElementById('panel-tagline').textContent = `"${data.tagline}"`;
            document.getElementById('metric-cost').textContent = data.cost;
            document.getElementById('metric-wlb').textContent = data.wlb;
            document.getElementById('metric-safety').textContent = data.safety;

            const badge = document.getElementById('panel-badge');
            if (data.isCurated) {
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            const content = document.getElementById('panel-content');
            content.scrollTop = 0;

            content.innerHTML = `
                <!-- External Videos Section -->
                <section class="paper-card rounded-2xl p-5">
                    <div class="flex items-center justify-between mb-3.5">
                        <h3 class="font-display font-bold text-xs uppercase tracking-wider text-[#52827b] flex items-center gap-2">
                            <svg class="w-4 h-4 text-[#e8998d]" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                            Watch: Day in the Life & Street Walks
                        </h3>
                        <span class="text-[11px] text-stone-400 font-medium">External Links</span>
                    </div>
                    <div class="space-y-2.5">
                        ${data.videos.map(v => `
                            <a href="${v.url}" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-3 p-3 rounded-xl bg-paper-100 hover:bg-[#f5ede3] shadow-paper-sm hover:shadow-paper transition-all">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-9 h-9 rounded-lg bg-[#fbe5e2] text-[#c96e61] flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                    </div>
                                    <div class="truncate">
                                        <div class="text-sm font-semibold text-paper-900 group-hover:text-[#c96e61] truncate transition-colors">${v.title}</div>
                                        <div class="text-xs text-stone-500">${v.channel} • ${v.duration}</div>
                                    </div>
                                </div>
                                <svg class="w-4 h-4 text-stone-400 group-hover:text-[#c96e61] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                </svg>
                            </a>
                        `).join('')}
                    </div>
                </section>

                <!-- Upsides & Downsides Grid -->
                <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="bg-[#eef7f1] shadow-paper rounded-2xl p-5">
                        <h4 class="font-display font-bold text-sm text-[#457268] flex items-center gap-2 mb-3">
                            <i class="fa-solid fa-circle-arrow-up text-[#699e90]"></i> The Upsides
                        </h4>
                        <ul class="space-y-2.5 text-xs sm:text-sm text-stone-700 leading-relaxed">
                            ${data.upsides.map(item => `<li class="flex items-start gap-2.5"><i class="fa-solid fa-check text-[#699e90] text-xs mt-1 shrink-0"></i><span>${item}</span></li>`).join('')}
                        </ul>
                    </div>
                    <div class="bg-[#fcf0ee] shadow-paper rounded-2xl p-5">
                        <h4 class="font-display font-bold text-sm text-[#b35e54] flex items-center gap-2 mb-3">
                            <i class="fa-solid fa-circle-arrow-down text-[#d98479]"></i> The Downsides
                        </h4>
                        <ul class="space-y-2.5 text-xs sm:text-sm text-stone-700 leading-relaxed">
                            ${data.downsides.map(item => `<li class="flex items-start gap-2.5"><i class="fa-solid fa-minus text-[#d98479] text-xs mt-1 shrink-0"></i><span>${item}</span></li>`).join('')}
                        </ul>
                    </div>
                </section>

                <!-- Daily Rhythm: Workday & Evening -->
                <section class="space-y-4">
                    <div class="bg-[#fdf8ee] shadow-paper rounded-2xl p-5">
                        <h4 class="font-display font-bold text-base text-paper-900 flex items-center gap-2.5 mb-2">
                            <span class="w-7 h-7 rounded-lg bg-[#faebd2] text-[#c78538] flex items-center justify-center text-xs"><i class="fa-solid fa-sun"></i></span>
                            What a Typical Workday is Like
                        </h4>
                        <p class="text-sm text-stone-700 leading-relaxed">${data.workday}</p>
                    </div>

                    <div class="bg-[#f3f2fa] shadow-paper rounded-2xl p-5">
                        <h4 class="font-display font-bold text-base text-paper-900 flex items-center gap-2.5 mb-2">
                            <span class="w-7 h-7 rounded-lg bg-[#e5e2f5] text-[#6d629c] flex items-center justify-center text-xs"><i class="fa-solid fa-moon"></i></span>
                            What a Typical Evening is Like
                        </h4>
                        <p class="text-sm text-stone-700 leading-relaxed">${data.evening}</p>
                    </div>
                </section>

                <!-- Culture, People, Cost of Living -->
                <section class="space-y-4 pb-6">
                    <div class="paper-card rounded-2xl p-5">
                        <h4 class="font-display font-bold text-base text-paper-900 flex items-center gap-2.5 mb-2">
                            <span class="w-7 h-7 rounded-lg bg-[#fbe5e2] text-[#c96e61] flex items-center justify-center text-xs"><i class="fa-solid fa-masks-theater"></i></span>
                            The Culture
                        </h4>
                        <p class="text-sm text-stone-700 leading-relaxed">${data.culture}</p>
                    </div>
                    <div class="paper-card rounded-2xl p-5">
                        <h4 class="font-display font-bold text-base text-paper-900 flex items-center gap-2.5 mb-2">
                            <span class="w-7 h-7 rounded-lg bg-[#dff0ea] text-[#457268] flex items-center justify-center text-xs"><i class="fa-solid fa-people-group"></i></span>
                            The People & Social Vibe
                        </h4>
                        <p class="text-sm text-stone-700 leading-relaxed">${data.people}</p>
                    </div>
                    <div class="paper-card rounded-2xl p-5">
                        <h4 class="font-display font-bold text-base text-paper-900 flex items-center gap-2.5 mb-2">
                            <span class="w-7 h-7 rounded-lg bg-[#fdf0dc] text-[#b87b35] flex items-center justify-center text-xs"><i class="fa-solid fa-coins"></i></span>
                            Cost of Living Breakdown
                        </h4>
                        <p class="text-sm text-stone-700 leading-relaxed">${data.costOfLiving}</p>
                    </div>
                </section>
            `;

            document.getElementById('country-panel').classList.remove('translate-x-full');
        }

        function closeCountryPanel() {
            document.getElementById('country-panel').classList.add('translate-x-full');
        }

        // Search Bar Functionality
        const searchInput = document.getElementById('country-search');
        const searchResults = document.getElementById('search-results');

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.trim().toLowerCase();
            if (!query) {
                searchResults.classList.add('hidden');
                return;
            }

            const matches = worldFeatures
                .filter(f => (f.properties.name || "").toLowerCase().includes(query))
                .slice(0, 8);

            if (matches.length === 0) {
                searchResults.innerHTML = `<div class="px-4 py-3 text-xs text-stone-500">No matching country found</div>`;
            } else {
                searchResults.innerHTML = matches.map(f => {
                    const name = f.properties.name === "Viet Nam" ? "Vietnam" : f.properties.name;
                    const isCurated = !!COUNTRY_DATABASE[name];
                    return `
                        <button class="w-full text-left px-3.5 py-2.5 text-sm rounded-xl hover:bg-paper-100 flex items-center justify-between transition-colors" data-country="${f.properties.name}">
                            <span class="text-paper-900 font-medium">${name}</span>
                            ${isCurated ? '<span class="text-[11px] text-[#d47a6c] font-semibold">Full Guide</span>' : '<span class="text-[11px] text-stone-400">Overview</span>'}
                        </button>
                    `;
                }).join('');
            }
            searchResults.classList.remove('hidden');
        });

        searchResults.addEventListener('click', (e) => {
            const btn = e.target.closest('button[data-country]');
            if (!btn) return;
            const targetName = btn.getAttribute('data-country');
            const feature = worldFeatures.find(f => f.properties.name === targetName);
            if (feature) {
                selectCountry(feature);
                searchInput.value = "";
                searchResults.classList.add('hidden');
            }
        });

        document.addEventListener('click', (e) => {
            if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                searchResults.classList.add('hidden');
            }
        });

        // ==========================================
        // RELOCATION QUIZ LOGIC
        // ==========================================
        const quizModal = document.getElementById('quiz-modal');
        const quizBody = document.getElementById('quiz-body');
        const quizProgress = document.getElementById('quiz-progress');
        const quizSubtitle = document.getElementById('quiz-subtitle');

        function openQuiz() {
            currentQuizStep = 0;
            selectedQuizTags = [];
            quizModal.classList.remove('hidden');
            quizModal.classList.add('flex');
            renderQuizStep();
        }

        function closeQuiz() {
            quizModal.classList.add('hidden');
            quizModal.classList.remove('flex');
        }

        function renderQuizStep() {
            const total = QUIZ_QUESTIONS.length;
            const q = QUIZ_QUESTIONS[currentQuizStep];
            const pct = ((currentQuizStep + 1) / total) * 100;

            quizProgress.style.width = `${pct}%`;
            quizSubtitle.textContent = `Question ${currentQuizStep + 1} of ${total}`;

            quizBody.innerHTML = `
                <div class="space-y-6">
                    <div>
                        <h4 class="font-display text-xl sm:text-2xl font-bold text-paper-900">${q.question}</h4>
                        <p class="text-sm text-stone-500 mt-1">${q.subtitle}</p>
                    </div>

                    <div class="space-y-3.5">
                        ${q.options.map((opt, idx) => `
                            <button onclick="handleQuizAnswer('${opt.tag}')" class="w-full text-left p-4 rounded-2xl paper-card hover:bg-[#fffaf3] hover:-translate-y-0.5 hover:shadow-paper-lg transition-all group flex items-center gap-4">
                                <span class="text-lg sm:text-xl bg-[#f5efe6] text-[#52827b] group-hover:bg-[#fbe5e2] group-hover:text-[#c96e61] w-12 h-12 rounded-xl flex items-center justify-center shrink-0 transition-colors shadow-paper-sm">
                                    <i class="${opt.icon}"></i>
                                </span>
                                <div>
                                    <div class="font-display font-bold text-base text-paper-900 group-hover:text-[#c96e61] transition-colors">${opt.label}</div>
                                    <div class="text-xs sm:text-sm text-stone-500 mt-0.5">${opt.desc}</div>
                                </div>
                            </button>
                        `).join('')}
                    </div>

                    ${currentQuizStep > 0 ? `
                        <div class="pt-2 flex justify-start">
                            <button onclick="prevQuizStep()" class="text-xs font-semibold text-stone-500 hover:text-paper-900 flex items-center gap-1.5">
                                <i class="fa-solid fa-arrow-left"></i> Previous Question
                            </button>
                        </div>
                    ` : ''}
                </div>
            `;
        }

        window.handleQuizAnswer = function(tag) {
            selectedQuizTags[currentQuizStep] = tag;
            if (currentQuizStep < QUIZ_QUESTIONS.length - 1) {
                currentQuizStep++;
                renderQuizStep();
            } else {
                calculateQuizResult();
            }
        };

        window.prevQuizStep = function() {
            if (currentQuizStep > 0) {
                currentQuizStep--;
                renderQuizStep();
            }
        };

        function calculateQuizResult() {
            quizProgress.style.width = "100%";
            quizSubtitle.textContent = "Your Personalized Global Match";

            const scored = Object.values(COUNTRY_DATABASE).map(country => {
                let score = 0;
                selectedQuizTags.forEach(tag => {
                    if (country.tags && country.tags.includes(tag)) {
                        score += 2;
                    }
                });
                return { country, score };
            }).sort((a, b) => b.score - a.score);

            const bestMatch = scored[0].country;
            const runnerUp = scored[1].country;
            const matchPercent = Math.min(98, Math.max(76, 70 + scored[0].score * 4));

            quizBody.innerHTML = `
                <div class="text-center space-y-5">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#dff0ea] text-[#457268] text-xs font-bold uppercase tracking-wider shadow-paper-sm">
                        <i class="fa-solid fa-sparkles"></i> ${matchPercent}% Lifestyle Compatibility
                    </div>

                    <div>
                        <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-[#fbe5e2] text-[#c96e61] flex items-center justify-center text-3xl shadow-paper">
                            <i class="${bestMatch.icon}"></i>
                        </div>
                        <h3 class="font-display text-3xl font-extrabold text-paper-900">You Should Live in ${bestMatch.name}!</h3>
                        <p class="font-serif italic text-base text-stone-500 max-w-lg mx-auto mt-2">"${bestMatch.tagline}"</p>
                    </div>

                    <div class="paper-card rounded-2xl p-5 text-left space-y-2">
                        <div class="text-xs font-bold uppercase tracking-wider text-[#52827b]">Why ${bestMatch.name} fits your answers:</div>
                        <p class="text-sm text-stone-700 leading-relaxed">${bestMatch.culture}</p>
                        <div class="grid grid-cols-3 gap-2 pt-3 text-center mt-3 bg-paper-100 rounded-xl p-2.5">
                            <div>
                                <div class="text-[11px] text-stone-500">Est. Monthly</div>
                                <div class="text-xs font-bold text-paper-900">${bestMatch.cost}</div>
                            </div>
                            <div>
                                <div class="text-[11px] text-stone-500">Work-Life</div>
                                <div class="text-xs font-bold text-[#52827b]">${bestMatch.wlb}</div>
                            </div>
                            <div>
                                <div class="text-[11px] text-stone-500">Safety</div>
                                <div class="text-xs font-bold text-[#6c6394]">${bestMatch.safety}</div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                        <button onclick="flyToMatchedCountry('${bestMatch.name}')" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-[#e8998d] hover:bg-[#df8577] text-white font-display font-bold text-sm shadow-paper transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2">
                            <span>Zoom to ${bestMatch.name} on Map</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                        <button onclick="flyToMatchedCountry('${runnerUp.name}')" class="w-full sm:w-auto px-4 py-3 rounded-xl paper-card hover:bg-paper-50 text-paper-900 font-medium text-sm transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2">
                            <i class="${runnerUp.icon} text-[#52827b]"></i>
                            <span>Runner-up: ${runnerUp.name}</span>
                        </button>
                    </div>

                    <button onclick="openQuiz()" class="text-xs font-medium text-stone-500 hover:text-paper-900 underline pt-1">
                        Retake Quiz
                    </button>
                </div>
            `;
        }

        window.flyToMatchedCountry = function(countryName) {
            closeQuiz();
            const feature = worldFeatures.find(f => {
                const n = f.properties.name === "Viet Nam" ? "Vietnam" : (f.properties.name === "Korea" ? "South Korea" : f.properties.name);
                return n === countryName;
            });
            if (feature) {
                selectCountry(feature);
                showToast(`Zooming into ${countryName}...`);
            }
        };

        // Event Listeners
        document.getElementById('close-panel-btn').addEventListener('click', closeCountryPanel);
        document.getElementById('reset-zoom-btn').addEventListener('click', resetZoom);
        document.getElementById('open-quiz-btn').addEventListener('click', openQuiz);
        document.getElementById('close-quiz-btn').addEventListener('click', closeQuiz);

        // Handle Window Resize Responsively
        window.addEventListener('resize', () => {
            const container = document.getElementById('map-container');
            if (svg && container) {
                svg.attr("viewBox", [0, 0, container.clientWidth, container.clientHeight]);
            }
        });

        // Boot Application
        window.onload = () => {
            initWorldMap();
        };
    </script>
</body>
</html>
